# Supabase 專案配置 (用於全網按讚數與瀏覽量持久化統計)
# 請至 https://supabase.com 建立專案後，於 Project Settings -> API 複製以下數值：
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GitHub Discussions Bot 配置 (用於 Vercel Serverless Function 轉發訪客免帳號留言至 Giscus)
# 請至 GitHub -> Settings -> Developer Settings -> Personal access tokens 產生具備 discussions:write (或 public_repo) 權限的 Token
# 僅在 Vercel 後端環境變數配置即可，前端不暴露
GITHUB_BOT_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO_OWNER=WSMao
GITHUB_REPO_NAME=100-apps-challenge
GITHUB_CATEGORY_ID=DIC_kwDOU1naVM4DGwMC
